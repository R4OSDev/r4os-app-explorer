R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=EXPLORER
VERSION=0.1.6
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=gui
TARGET=/R4OS/SOFTWARE/DESKTOP/EXPLORER.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4NET:Query:1
IMPORT=R4DEV:Query:1
RESOURCE=BACK.ICO:Assets/BACK.ico
RESOURCE=FORWARD.ICO:Assets/FORWARD.ico
RESOURCE=UP.ICO:Assets/UP.ico
RESOURCE=CUT.ICO:Assets/CUT.ico
RESOURCE=COPY.ICO:Assets/COPY.ico
RESOURCE=PASTE.ICO:Assets/PASTE.ico
RESOURCE=DELETE.ICO:Assets/DELETE.ico
META=desktop.launch=hosted
ICON=Assets/Desktop.ico
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:DATE_V1:1
IMPORT=R4STD:TIME_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
